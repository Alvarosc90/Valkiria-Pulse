NODE_ENV=production
PORT=4200
PULSE_HTTP_PORT=8081

APP_URL=https://pulse.valkiria.tech
API_URL=https://pulse.valkiria.tech
OAUTH_PUBLIC_BASE_URL=https://pulse.valkiria.tech
CORS_ORIGIN=https://pulse.valkiria.tech,https://trainia.valkiria.tech

DB_NAME=valkiria_pulse
DB_USER=pulse
DB_PASSWORD=
PULSE_DB_ROOT_PASSWORD=
DB_CONNECTION_LIMIT=10

AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE=pulse_refresh
CREDENTIALS_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://pulse.valkiria.tech
PUBLIC_SIGNUP_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Valkiria PULSE <no-reply@valkiria.tech>
SMTP_HELO_NAME=pulse.valkiria.tech
SMTP_TIMEOUT_MS=10000
PULSE_CONTACT_EMAIL=consultas@valkiria.tech
PULSE_SUPPORT_EMAIL=soporte@valkiria.tech

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=production

# Recommended launch profile: OpenAI project/service-account owned by Valkiria Project.
# Keep the key only in the production .env (mode 600); never expose it to the browser.
PULSE_LLM_PROVIDER=openai
PULSE_LLM_BASE_URL=https://api.openai.com
PULSE_LLM_API_KEY=
PULSE_LLM_MODEL=gpt-6-luna
PULSE_LLM_TIMEOUT_MS=45000
PULSE_LLM_MAX_CONCURRENCY=8
PULSE_LLM_MAX_RETRIES=1
# Standard short-context launch pricing snapshot; update if provider pricing changes.
PULSE_LLM_INPUT_USD_PER_MILLION=0.10
PULSE_LLM_CACHED_INPUT_USD_PER_MILLION=0.01
PULSE_LLM_OUTPUT_USD_PER_MILLION=0.50

# Premium video is prepaid and disabled until the fal provider is production-ready.
PULSE_VIDEO_COMMERCE_ENABLED=false
PULSE_VIDEO_PROVIDER=fal
FAL_API_KEY=
PULSE_VIDEO_PROVIDER_BUFFER_USD=25
PULSE_WORKER_INTERVAL_MS=30000
PULSE_TOKEN_REFRESH_INTERVAL_MS=900000

PULSE_MEDIA_DIR=/app/data/media
PULSE_MEDIA_PUBLIC_TTL_HOURS=168
PULSE_MEDIA_MAX_MB=100

TRAINIA_SSO_SECRET=
TRAINIA_SSO_ISSUER=trainia
TRAINIA_SSO_AUDIENCE=valkiria-pulse

PULSE_BACKUP_DIR=/opt/valkiria-pulse/backups
PULSE_BACKUP_INTERVAL_SECONDS=86400
PULSE_BACKUP_RETENTION_DAYS=14

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile email w_member_social

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
