FROM mysql:8.4

USER root
RUN microdnf install -y tar gzip findutils coreutils && microdnf clean all

COPY deploy/production/backup-container.sh /usr/local/bin/pulse-backup
COPY deploy/production/backup-loop.sh /usr/local/bin/pulse-backup-loop
RUN chmod 0755 /usr/local/bin/pulse-backup /usr/local/bin/pulse-backup-loop

ENTRYPOINT ["/usr/local/bin/pulse-backup-loop"]
