NODE_ENV=development
PORT=4200
APP_URL=http://localhost:5173
API_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:5173
OAUTH_PUBLIC_BASE_URL=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pulse
DB_PASSWORD=
DB_NAME=valkiria_pulse
DB_CONNECTION_LIMIT=10

AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE=pulse_refresh
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_SIGNUP_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_HELO_NAME=pulse.local
SMTP_TIMEOUT_MS=10000
PULSE_CONTACT_EMAIL=consultas@valkiria.tech
PULSE_SUPPORT_EMAIL=soporte@valkiria.tech

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=unknown

# Optional local bootstrap owner. Never use a committed/default password.
PULSE_DEV_OWNER_EMAIL=
PULSE_DEV_OWNER_PASSWORD=

# Optional AI model gateway. For production OpenAI, use a project-scoped service-account key.
PULSE_LLM_PROVIDER=compatible
PULSE_LLM_BASE_URL=
PULSE_LLM_API_KEY=
PULSE_LLM_MODEL=
PULSE_LLM_TIMEOUT_MS=45000
PULSE_LLM_MAX_CONCURRENCY=8
PULSE_LLM_MAX_RETRIES=1
PULSE_LLM_INPUT_USD_PER_MILLION=0
PULSE_LLM_CACHED_INPUT_USD_PER_MILLION=0
PULSE_LLM_OUTPUT_USD_PER_MILLION=0

# Premium video is prepaid and disabled until the fal provider is production-ready.
PULSE_VIDEO_COMMERCE_ENABLED=false
PULSE_VIDEO_PROVIDER=fal
FAL_API_KEY=
PULSE_VIDEO_PROVIDER_BUFFER_USD=25

PULSE_MEDIA_DIR=./data/media
PULSE_MEDIA_PUBLIC_TTL_HOURS=168
PULSE_MEDIA_MAX_MB=100

TRAINIA_SSO_SECRET=
TRAINIA_SSO_ISSUER=trainia
TRAINIA_SSO_AUDIENCE=valkiria-pulse

# Growth events are signed server-to-server. Keep disabled until a dedicated secret is configured.
PULSE_GROWTH_INTEGRATIONS_ENABLED=false
TRAINIA_GROWTH_SECRET=
TRAINIA_GROWTH_AUDIENCE=valkiria-pulse-growth

# 32-byte key encoded as base64. Used to encrypt social credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile email w_member_social

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
